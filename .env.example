# Copia este archivo como ".env" (no lo subas a git) y llena tus valores.
# Los que dicen "igual en los 3" deben coincidir EXACTO en el .env de tus companeros.

# --- Identidad de ESTE nodo (cambia segun quien lo corre) ---
NODE_NAME=nodo1
MY_TAILSCALE_IP=100.x.x.1
NOFAILOVER=false          # true SOLO en el .env de quien tenga el nodo3
NOSYNC=false              # true SOLO en el .env de quien tenga el nodo3

# --- IPs de Tailscale de los 3 nodos (igual en los 3 .env) ---
IP_NODO1=100.x.x.1
IP_NODO2=100.x.x.2
IP_NODO3=100.x.x.3

# --- Credenciales compartidas (igual en los 3 .env) ---
REPLICATION_PASSWORD=cambiar_esto
SUPERUSER_PASSWORD=cambiar_esto
