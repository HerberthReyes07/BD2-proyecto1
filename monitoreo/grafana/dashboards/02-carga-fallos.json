    {
      "type": "timeseries",
      "title": "Lag de replicación bajo carga",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "description": "Bajo carga alta la réplica asíncrona (nodo3) se retrasa; la síncrona (nodo2) no. El líder se excluye con 'and patroni_primary == 0': no replaya WAL, así que su xlog_replayed_location es 0 y aparecería con un lag falso enorme.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
