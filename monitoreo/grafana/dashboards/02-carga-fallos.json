        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(scalar(max(patroni_xlog_location)) - patroni_xlog_replayed_location) and (patroni_primary == 0)",
          "legendFormat": "{{nodo}}",
          "refId": "A"
        }
