# Construye etcd desde el binario oficial de GitHub Releases,
# en vez de depender de una imagen de terceros (bitnami cambio su
# catalogo y ya no ofrece tags simples como "3.5" de forma confiable).
FROM debian:bookworm-slim

ARG ETCD_VERSION=v3.5.17

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -L https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/etcd-${ETCD_VERSION}-linux-amd64.tar.gz \
       | tar xz -C /usr/local/bin --strip-components=1 \
         etcd-${ETCD_VERSION}-linux-amd64/etcd \
         etcd-${ETCD_VERSION}-linux-amd64/etcdctl \
    && rm -rf /var/lib/apt/lists/*

# etcd lee su configuracion de variables de entorno ETCD_* de forma nativa,
# no necesitamos pasarle argumentos.
ENTRYPOINT ["etcd"]
